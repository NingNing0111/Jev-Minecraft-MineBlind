MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=MineBlind
MC_VERSION=1.20.1
MC_AUTH=offline

# A: Jev only; B: Agent unlimited; C: gate; D: web; E: persistent knowledge
EXPERIMENT_MODE=A
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_API_KEY=
# B-E require the selected provider's credentials. Never commit real keys.
# mastra: standard model router; openai-responses: explicit custom Responses API
AGENT_PROVIDER=mastra
AGENT_MODEL=openai/gpt-4.1
OPENAI_API_KEY=
# Custom gateway: set AGENT_PROVIDER=openai-responses and AGENT_MODEL=gemini-3.8-flash-high
AGENT_BASE_URL=https://ai-gateway.pgthinker.me/v1
AGENT_API_KEY=
# D-E only
TAVILY_API_KEY=
DECISION_INTERVAL_MS=1000
STAGNATION_MS=120000
AGENT_COOLDOWN_MS=30000
SAVE_INTERVAL_MS=300000
SAVE_DIR=saves
KNOWLEDGE_DIR=knowledge
# Set a unique identity when reusing host:port for a different world.
WORLD_ID=local-world
# Empty starts a new run; latest or an explicit snapshot directory resumes.
RESTORE_SAVE=

# Docker Compose only (see DOCKER.md). Accept the EULA yourself before starting.
MINECRAFT_EULA=FALSE
BIND_IP=127.0.0.1
MC_MEMORY=2G
MC_CONTAINER_MEMORY=3G
BOT_CONTAINER_MEMORY=2G
MC_SEED=
# For Docker, change WORLD_ID above to docker-world (or your unique world ID).
# Use RESTORE_SAVE=latest to resume AI state after container restarts.
